<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Background Illustration: Pouring Bottles -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/illustration"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnStart"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3">

        <!-- Target Bottle (Bottom Right) -->
        <ImageView
            android:id="@+id/targetBottle"
            android:layout_width="140dp"
            android:layout_height="280dp"
            android:layout_marginEnd="20dp"
            android:rotation="15"
            android:scaleType="fitXY"
            android:src="@drawable/bottle_vector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.8" />

        <!-- Source Bottle (Top Left) -->
        <ImageView
            android:id="@+id/sourceBottle"
            android:layout_width="140dp"
            android:layout_height="280dp"
            android:layout_marginStart="20dp"
            android:rotation="-50"
            android:scaleType="fitXY"
            android:src="@drawable/bottle_vector"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Liquid Stream (Simplified) -->
        <View
            android:layout_width="45dp"
            android:layout_height="120dp"
            android:background="@color/liquid_blue"
            android:rotation="-10"
            app:layout_constraintBottom_toTopOf="@id/targetBottle"
            app:layout_constraintEnd_toEndOf="@id/sourceBottle"
            app:layout_constraintStart_toEndOf="@id/sourceBottle"
            app:layout_constraintTop_toTopOf="@id/targetBottle"
            app:layout_constraintHorizontal_bias="0.2"
            app:layout_constraintVertical_bias="0.1"/>

        <!-- Sparkles -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_sparkle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_sparkle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.2" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Start Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStart"
        android:layout_width="260dp"
        android:layout_height="72dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/button_circular_glow"
        android:backgroundTint="@color/button_green"
        android:text="@string/start"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/btnQuitStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Quit Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnQuitStart"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:layout_marginBottom="100dp"
        android:background="@drawable/button_rect_round"
        android:backgroundTint="#FF5252"
        android:text="@string/quit"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Privacy Policy -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/checkbox_on_background"
            app:tint="@color/button_green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/privacy_policy_accept"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>