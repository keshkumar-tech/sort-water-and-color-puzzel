<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <!-- Glow Layer -->
            <item
                android:bottom="-2dp"
                android:left="-2dp"
                android:right="-2dp"
                android:top="-2dp">
                <shape android:shape="oval">
                    <solid android:color="@color/button_purple_glow" />
                </shape>
            </item>
            <!-- Main Button Layer -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/button_purple" />
                    <stroke
                        android:width="1dp"
                        android:color="#40FFFFFF" />
                    <size
                        android:width="60dp"
                        android:height="60dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>